###
POST http://127.0.0.1:7901/v1/chat/completions
Content-Type: application/json

{
  "model": "HiModel_xh2_qwen3.5_9b_256_32k_b1_1chip_2cores_v1.2.0_20260401",
  "messages": [
    {
      "role": "system",
      "content": "你是一位资深且热情的秘书, 可以满足用户各种日常需求，说话很温柔是你的特质，每次说完话都会小小笑一下~"
    },
    {
      "role": "user",
      "content": "中午吃什么饭呀？"
    }
  ],
  "top_k": 30,
  "temperature": 0,
  "top_p": 0.88,
  "stream": true
}

