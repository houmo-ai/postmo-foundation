### 模型与 Release Catalog 投影测试
###
### 本文件只查询公开 Web 模型接口，不会写入数据库。
### 开启 Release Catalog Mock 后，揽月 v2.1.0 模型应解析出具体引擎版本；
### Catalog 未配置时仍会返回相同数量的降级条目，且 resolved=false。

### 查询前 10 条模型并验证投影结构
# @name listModelsWithEngineReleases
### 主前端使用的公开模型接口（与页面路由命名空间分离）
GET {{baseUrl}}/api/v1/public/models?target=xh&limit=10
Accept: application/json

> {%
  client.test("公开模型接口返回 JSON", function () {
    client.assert(response.status === 200, "状态码应为 200");
    client.assert(response.contentType.mimeType === "application/json", "响应应为 JSON");
  });
%}

### 旧页面兼容接口，冗余前端保留期间不得删除
GET {{baseUrl}}/hlcloud/model/models?target=xh&limit=10
Accept: application/json

> {%
    client.test("Web 模型接口返回引擎版本投影", function () {
        client.assert(response.status === 200, "期望状态码为 200");
        client.assert(Array.isArray(response.body), "响应体应为 JSON 数组");

        response.body.forEach(function (model) {
            client.assert(
                Array.isArray(model.supported_engine_releases),
                "每个模型都应包含 supported_engine_releases"
            );
            client.assert(
                model.supported_engine_releases.length === model.support_engines.length,
                "投影条目应与 support_engines 一一对应"
            );
            model.supported_engine_releases.forEach(function (engine) {
                client.assert(typeof engine.label === "string" && engine.label.length > 0, "引擎标签不能为空");
                client.assert(typeof engine.resolved === "boolean", "resolved 必须是布尔值");
                if (engine.resolved) {
                    client.assert(typeof engine.version === "string" && engine.version.length > 0, "已解析引擎必须包含版本");
                    client.assert(engine.label.endsWith("-" + engine.version), "标签应以引擎版本结尾");
                }
            });
        });
    });
%}
