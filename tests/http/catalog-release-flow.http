        client.assert(response.body.relation_type === "bundled", "关系类型应为 bundled");
    });
%}

### 12. 查询完整发布清单：同时验证 Release Note、组件版本和软件下载地址
# @name getPlatformReleaseManifest
GET {{baseUrl}}/api/v1/catalog/products/{{httpPlatformCode}}/releases/v1.0.0-http-test
Authorization: Bearer {{adminToken}}
Accept: application/json

> {%
    client.test("完整发布清单组装正确", function () {
        client.assert(response.status === 200, "期望状态码为 200");
        client.assert(response.body.product.code === client.global.get("httpPlatformCode"), "平台产品编码不正确");
        client.assert(response.body.notes.length === 1, "应包含一条 Release Note");
        client.assert(response.body.components.length === 2, "应包含推理引擎和 AI 助手两个组件");

        var engineCode = client.global.get("httpEngineCode");
        var engine = response.body.components.find(function (item) {
            return item.product.code === engineCode;
        });
        client.assert(engine !== undefined, "应包含推理引擎组件");
        client.assert(engine.release.artifacts.length === 1, "推理引擎应包含一个软件制品");
        client.assert(engine.release.artifacts[0].locations.length === 2, "制品应包含内网和外网两个下载地址");
    });
%}

### 13. 查询 stable 渠道的最新已发布版本
# @name getLatestPlatformRelease
GET {{baseUrl}}/api/v1/catalog/products/{{httpPlatformCode}}/releases/latest?channel=stable
Authorization: Bearer {{adminToken}}
Accept: application/json

> {%
    client.test("最新版本查询正确", function () {
        client.assert(response.status === 200, "期望状态码为 200");
        client.assert(response.body.release.version === "v1.0.0-http-test", "最新版本号不正确");
    });
%}

### 14. 停用平台测试产品；停用后默认产品列表不会展示它
# @name deactivatePlatformProduct
PATCH {{baseUrl}}/api/v1/catalog/products/{{httpPlatformCode}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json
Accept: application/json

{
  "is_active": false
}

> {%
    client.test("平台测试产品已停用", function () {
        client.assert(response.status === 200, "期望状态码为 200");
        client.assert(response.body.is_active === false, "产品应处于停用状态");
    });
%}

