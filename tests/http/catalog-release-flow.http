### 7. 添加揽月中文 Release Note；PUT 可重复执行并更新已有内容
# @name upsertPlatformReleaseNote
PUT {{baseUrl}}/api/v1/catalog/products/{{httpPlatformCode}}/releases/v1.0.0-http-test/notes/zh-CN
Authorization: Bearer {{adminToken}}
Content-Type: application/json
Accept: application/json

{
  "format": "markdown",
  "summary": "HTTP Client 集成测试版本",
  "content": "## 更新内容\n\n- 关联推理引擎版本\n- 关联揽月 AI 助手版本\n- 验证软件下载地址"
}

> {%
    client.test("Release Note 写入成功", function () {
        client.assert(response.status === 200, "期望状态码为 200");
        client.assert(response.body.locale === "zh-CN", "语言应为 zh-CN");
        client.assert(response.body.format === "markdown", "格式应为 markdown");
    });
%}

### 8. 为推理引擎版本添加软件制品和外网下载地址
# @name createEngineArtifact
POST {{baseUrl}}/api/v1/catalog/products/{{httpEngineCode}}/releases/v3.2.0-http-test/artifacts
Authorization: Bearer {{adminToken}}
Content-Type: application/json
Accept: application/json

{
  "name": "http-engine-v3.2.0-linux-x86_64.tar.gz",
  "artifact_type": "archive",
  "os": "linux",
  "architecture": "x86_64",
  "package_format": "tar.gz",
  "checksum_algorithm": "sha256",
  "checksum": "http-client-test-checksum",
  "size_bytes": 1048576,
  "published_at": "2026-08-03T10:00:00+08:00",
  "extra": {
    "testData": true
  },
  "locations": [
    {
      "network_scope": "external",
      "region": "default",
      "uri": "https://downloads.example.com/http-engine-v3.2.0.tar.gz",
      "priority": 100,
      "is_active": true
    }
  ]
}

> {%
    client.test("推理引擎制品创建成功", function () {
        client.assert(response.status === 201, "期望状态码为 201");
        client.assert(response.body.locations.length === 1, "应包含一个下载地址");
    });
    client.global.set("httpArtifactId", response.body.id);
%}

### 9. 为同一个制品增加内网下载地址
# @name addInternalArtifactLocation
POST {{baseUrl}}/api/v1/catalog/artifacts/{{httpArtifactId}}/locations
Authorization: Bearer {{adminToken}}
Content-Type: application/json
Accept: application/json

{
  "network_scope": "internal",
  "region": "cn",
  "uri": "https://downloads.internal.example.com/http-engine-v3.2.0.tar.gz",
  "priority": 10,
  "is_active": true
}

> {%
    client.test("内网下载地址创建成功", function () {
        client.assert(response.status === 201, "期望状态码为 201");
        client.assert(response.body.network_scope === "internal", "网络范围应为 internal");
    });
%}

### 10. 把推理引擎版本绑定到揽月版本
# @name bindEngineRelease
POST {{baseUrl}}/api/v1/catalog/products/{{httpPlatformCode}}/releases/v1.0.0-http-test/components
Authorization: Bearer {{adminToken}}
Content-Type: application/json
Accept: application/json

{
  "component_product_code": "{{httpEngineCode}}",
  "component_version": "v3.2.0-http-test",
  "relation_type": "required",
  "required": true,
  "configuration": {
    "testData": true
  }
}

> {%
    client.test("推理引擎版本绑定成功", function () {
        client.assert(response.status === 201, "期望状态码为 201");
        client.assert(response.body.relation_type === "required", "关系类型应为 required");
    });
%}

