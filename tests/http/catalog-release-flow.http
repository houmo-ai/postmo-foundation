### Release Catalog 完整发布流程测试
###
### 请按文件从上到下依次执行请求。前置请求会把动态生成的产品编码保存为全局变量，
### 后续请求会自动引用这些变量。测试数据最后会被停用，但不会物理删除，便于审计。
### 如果只想验证 GET /products，请运行 catalog-products.http，不要运行本文件。

### 1. 创建揽月平台产品
# @name createPlatformProduct
POST {{baseUrl}}/api/v1/catalog/products
Authorization: Bearer {{adminToken}}
Content-Type: application/json
Accept: application/json

{
  "code": "http-lanyue-{{$timestamp}}",
  "name": "揽月 HTTP Client 测试产品",
  "category": "platform",
  "description": "由 JetBrains HTTP Client 创建的临时平台产品",
  "extra": {
    "testData": true,
    "source": "tests/http/catalog-release-flow.http"
  },
  "is_active": true
}

> {%
    client.test("创建平台产品成功", function () {
        client.assert(response.status === 201, "期望状态码为 201");
        client.assert(response.body.category === "platform", "产品类别应为 platform");
    });
    client.global.set("httpPlatformCode", response.body.code);
%}

### 2. 创建推理引擎产品
# @name createEngineProduct
POST {{baseUrl}}/api/v1/catalog/products
Authorization: Bearer {{adminToken}}
Content-Type: application/json
Accept: application/json

{
  "code": "http-engine-{{$timestamp}}",
  "name": "HTTP Client 测试推理引擎",
  "category": "inference_engine",
  "description": "用于验证发布时间和软件下载地址",
  "extra": {
    "testData": true
  },
  "is_active": true
}

> {%
    client.test("创建推理引擎产品成功", function () {
        client.assert(response.status === 201, "期望状态码为 201");
        client.assert(response.body.category === "inference_engine", "产品类别应为 inference_engine");
    });
    client.global.set("httpEngineCode", response.body.code);
%}

