### 4. 创建揽月发布版本
# @name createPlatformRelease
POST {{baseUrl}}/api/v1/catalog/products/{{httpPlatformCode}}/releases
Authorization: Bearer {{adminToken}}
Content-Type: application/json
Accept: application/json

{
  "version": "v1.0.0-http-test",
  "channel": "stable",
  "status": "published",
  "published_at": "2026-08-04T10:00:00+08:00",
  "extra": {
    "testData": true
  }
}

> {%
    client.test("创建揽月发布版本成功", function () {
        client.assert(response.status === 201, "期望状态码为 201");
        client.assert(response.body.release.status === "published", "版本状态应为 published");
    });
%}

