@baseUrl = http://127.0.0.1:7901

### Get full sys.cfg
GET {{baseUrl}}/hlie/v2/config
Content-Type: application/json

### Get config by query section
GET {{baseUrl}}/hlie/v1/config?section=server
Content-Type: application/json

### Get config by path section
GET {{baseUrl}}/hlie/v1/config/server
Content-Type: application/json

### Get v2 config with section/key descriptions, types, and enum options
GET {{baseUrl}}/hlie/v2/config
Content-Type: application/json

### Get one v2 config section with metadata
GET {{baseUrl}}/hlie/v2/config/replica
Content-Type: application/json

### Update config by explicit section and values
POST {{baseUrl}}/hlie/v1/config
Content-Type: application/json

{
  "section": "config_test",
  "values": {
    "enabled": true,
    "name": "http_test",
    "count": 1
  }
}

### Update config by path section
POST {{baseUrl}}/hlie/v1/config/config_test
Content-Type: application/json

{
  "enabled": false,
  "name": "http_test_updated",
  "count": 2
}

### Update multiple sections
POST {{baseUrl}}/hlie/v1/config
Content-Type: application/json

{
  "config_test": {
    "enabled": true,
    "name": "multi_section_test"
  },
  "config_test_extra": {
    "value": "extra"
  }
}

### Read test section after updates
GET {{baseUrl}}/hlie/v1/config/config_test
Content-Type: application/json

### Add llm_params test key before delete
POST {{baseUrl}}/hlie/v1/config/llm_params
Content-Type: application/json

{
  "--config-test-delete": "1"
}

### Delete llm_params key by query
DELETE {{baseUrl}}/hlie/v1/config/llm_params?key=--config-test-delete
Content-Type: application/json

### Add llm_params test keys before batch delete
POST {{baseUrl}}/hlie/v1/config/llm_params
Content-Type: application/json

{
  "--config-test-delete-a": "a",
  "--config-test-delete-b": "b"
}

### Delete llm_params keys by body
DELETE {{baseUrl}}/hlie/v1/config/llm_params
Content-Type: application/json

{
  "keys": [
    "--config-test-delete-a",
    "--config-test-delete-b"
  ]
}

### Add llm_params test key before path delete
POST {{baseUrl}}/hlie/v1/config/llm_params
Content-Type: application/json

{
  "--config-test-delete-path": "path"
}

### Delete llm_params key by path
DELETE {{baseUrl}}/hlie/v1/config/llm_params/--config-test-delete-path
Content-Type: application/json

### Read llm_params after delete tests
GET {{baseUrl}}/hlie/v1/config/llm_params
Content-Type: application/json
